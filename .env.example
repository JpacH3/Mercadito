# Copia este archivo a ".env" y completa con tus valores reales.
# NUNCA subas el archivo ".env" real a git.

# Cadena de conexion de Neon (la encuentras en tu panel de Neon)
DATABASE_URL=postgresql://usuario:password@host.neon.tech/nombre_db?sslmode=require

# Clave secreta para firmar los tokens de sesion (JWT).
# Genera una propia, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Token del bot de Telegram (cuando lo configures)
TELEGRAM_BOT_TOKEN=
